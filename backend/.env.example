# Gigset backend — environment template.
# Copy to .env for local dev:   cp .env.example .env
# Then follow backend/SUPABASE_SETUP.md to create a free Supabase project
# and fill in the real values below.
#
# ⚠️  SECRETS — never commit .env, never paste these values into chat,
#     screenshots, or tickets. The service_role key and JWT secret in
#     particular grant full power over your project.

# ---------------------------------------------------------------- database
# Runtime connection → Supabase "transaction pooler" (port 6543).
# Find it at: Supabase dashboard → Database → Connect → Transaction pooler.
# Example: postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Migrations connection → Supabase "direct connection" (port 5432).
# Find it at: Supabase dashboard → Database → Connect → Direct connection.
# Prisma Migrate must use this (migrations can't run through the pooler).
# Example: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# ---------------------------------------------------------------- supabase
# Project URL + anon (public) key.
# Find them at: Supabase dashboard → Project Settings → API.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-public-key>"

# 🔒 SERVER-ONLY SECRET. Used to verify Supabase JWTs locally in Express.
# Find it at: Project Settings → API → "JWT Secret" (click Reveal).
# The backend refuses real tokens unless this is set. Never expose to the
# frontend, never commit, never paste into chat.
SUPABASE_JWT_SECRET=""

# 🔒 SERVER-ONLY SECRET. Bypasses Row Level Security — full admin access.
# Find it at: Project Settings → API → "service_role" key (click Reveal).
# Reserved for future admin scripts (e.g. backfills). Not used by the API
# today. Never expose to the frontend, never commit, never paste into chat.
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------ misc
# Local-dev mock auth (dev-<userId> tokens) is active ONLY while
# SUPABASE_URL / SUPABASE_JWT_SECRET are unset. The moment both are set,
# the API requires real Supabase JWTs and dev-login is disabled.
PORT=4000
