// Gigset — data model for the Indian music industry networking platform.
//
// Postgres (Supabase) is the production database.
//   - DATABASE_URL → Supabase transaction pooler (port 6543), used at runtime.
//   - DIRECT_URL   → Supabase direct connection (port 5432), used by Prisma
//                    Migrate for schema changes (migrations can't run through
//                    the pooler reliably).
// See SUPABASE_SETUP.md for the full setup walkthrough.
//
// No SQLite-specific features were ever used; every type below maps cleanly
// to Postgres (cuid() ids, Json → jsonb, native enums).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StakeholderType {
  PERFORMER
  VENUE
  BUYER
  CREW
  INSTITUTION
}

enum Visibility {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

enum ConnectionKind {
  CONNECT
  FOLLOW
}

enum PostVisibility {
  PUBLIC
  CONNECTIONS
}

enum OpportunityStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  REJECTED
  WITHDRAWN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ---------------------------------------------------------------- User/Profile
model User {
  id                 String             @id @default(cuid())
  // Supabase Auth user id (the JWT `sub` claim). Nullable so local dev-seed
  // users and the mock-auth fallback keep working; set on first sight of a
  // real Supabase JWT (see src/middleware/auth.js).
  authId             String?            @unique
  stakeholderType    StakeholderType
  name               String
  bio                String?
  city               String?
  // Public URL of the profile photo (Supabase Storage `post-media` bucket).
  avatarUrl          String?
  visibility         Visibility         @default(PUBLIC)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  // Growth: personal invite code, who invited this person, early-member badge.
  referralCode       String?            @unique
  referredById       String?
  foundingMember     Boolean            @default(false)
  // Contact + preferences for email / push alerts.
  email              String?
  // Age: used only to tune what we show (news filtering). Never returned to other people.
  birthDate          DateTime?
  contentOpen        Boolean            @default(false)
  emailAlerts        Boolean            @default(true)
  weeklyDigest       Boolean            @default(true)
  lastDigestAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  detail                  StakeholderDetail?
  posts                   Post[]
  stories                 Story[]
  comments                Comment[]
  likes                   Like[]
  following               Connection[]         @relation("Follower")
  followers               Connection[]         @relation("Followee")
  opportunities           Opportunity[]        @relation("Poster")
  applications            Application[]        @relation("Applicant")
  bookingsRequested       Booking[]            @relation("Requester")
  bookingsHosted          Booking[]            @relation("Host")
  sentMessages            Message[]            @relation("Sender")
  conversationMemberships ConversationMember[]
  notifications           Notification[]
  articles                Article[]            @relation("ArticleAuthor")
  tracks                  Track[]
  trackLikes              TrackLike[]
  createdGroups           CommunityGroup[]
  groupMemberships        GroupMember[]
  groupMessages           GroupMessage[]
  busyDays                Availability[]
  reportsMade             Report[]             @relation("Reporter")
  blocksMade              Block[]              @relation("Blocker")
  blockedBy               Block[]              @relation("Blocked")
  reviewsWritten          Review[]             @relation("Reviewer")
  reviewsReceived         Review[]             @relation("Reviewee")
  pushSubscriptions       PushSubscription[]

  @@index([stakeholderType])
  @@index([city])
}

// Polymorphic-ish type-specific profile fields (e.g. performer genres/instruments,
// venue capacity, buyer org). `type` mirrors StakeholderType; `data` is free-form.
model StakeholderDetail {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String
  data   Json
}

// ------------------------------------------------------------------ Social
model Connection {
  id         String           @id @default(cuid())
  followerId String
  follower   User             @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User             @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  status     ConnectionStatus @default(PENDING)
  kind       ConnectionKind   @default(FOLLOW)
  createdAt  DateTime         @default(now())

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

model Post {
  id         String         @id @default(cuid())
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  mediaUrl   String?
  visibility PostVisibility @default(PUBLIC)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  comments Comment[]
  likes    Like[]

  @@index([authorId])
  @@index([createdAt])
}

// Vault: image stories that disappear 12 hours after posting.
model Story {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaUrl  String
  caption   String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([authorId])
  @@index([expiresAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// ------------------------------------------------------------- Opportunities
model Opportunity {
  id           String            @id @default(cuid())
  posterId     String
  poster       User              @relation("Poster", fields: [posterId], references: [id], onDelete: Cascade)
  title        String
  description  String
  requirements Json?
  city         String?
  genre        String?
  budgetMin    Int?
  budgetMax    Int?
  status       OpportunityStatus @default(OPEN)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  applications Application[]

  @@index([status])
  @@index([city])
  @@index([createdAt])
}

model Application {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantId   String
  applicant     User              @relation("Applicant", fields: [applicantId], references: [id], onDelete: Cascade)
  status        ApplicationStatus @default(PENDING)
  intent        ApplicationIntent @default(PERFORM)
  message       String?
  createdAt     DateTime          @default(now())

  @@unique([opportunityId, applicantId])
  @@index([applicantId])
}

// --------------------------------------------------------------- Publishing
model Article {
  id          String    @id @default(cuid())
  title       String
  body        String
  excerpt     String?
  category    String?
  publishedAt DateTime?
  authorId    String?
  author      User?     @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([category])
  @@index([publishedAt])
}

// --------------------------------------------------------------- Messaging
model Conversation {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  // Receipts: sent = row exists; delivered = the recipient's app fetched it; read = they opened the chat.
  deliveredAt    DateTime?
  readAt         DateTime?

  @@index([conversationId])
  @@index([createdAt])
  @@index([conversationId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------- Bookings
// Mirrors the frontend BookingModal flow: a requester books a host (performer /
// venue / crew profile) for a date + time slot with a budget and a message.
model Booking {
  id          String        @id @default(cuid())
  requesterId String
  requester   User          @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  hostId      String
  host        User          @relation("Host", fields: [hostId], references: [id], onDelete: Cascade)
  date        String // ISO date string as picked in the booking modal (e.g. "2026-10-10")
  timeSlot    String? // e.g. "8–10 PM"
  budget      String? // e.g. "₹30k–60k" (free-form label, matches frontend budget buckets)
  message     String?
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([requesterId])
  @@index([hostId])
  @@index([status])
}

// ---------------------------------------------------- Directory (venues/events)
// Imported / curated directory data (e.g. OSM-sourced venues).
model Venue {
  id      String  @id @default(cuid())
  name    String
  city    String?
  lat     Float?
  lng     Float?
  type    String? // e.g. "live_music_venue", "club", "auditorium"
  address String?
  source  String  @default("manual") // e.g. "openstreetmap"

  @@index([city])
}

model Event {
  id     String    @id @default(cuid())
  title  String
  venue  String?
  city   String?
  date   DateTime?
  genre  String?
  url    String?
  source String    @default("manual")

  @@index([city])
  @@index([date])
}

// ============================================================
// User-testing batch (2026-09-29)
// ============================================================

enum TrackKind {
  TRACK
  BEAT
  SAMPLE
}

// Gighub: music uploads — the "code files" of the GitHub metaphor.
model Track {
  id          String    @id @default(cuid())
  uploaderId  String
  uploader    User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  title       String
  kind        TrackKind @default(TRACK)
  audioUrl    String
  durationSec Int?
  createdAt   DateTime  @default(now())

  likes TrackLike[]

  @@index([uploaderId])
  @@index([createdAt])
}

model TrackLike {
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([trackId, userId])
  @@index([userId])
}

enum GroupRole {
  ADMIN
  COADMIN
  MEMBER
}

// Community: WhatsApp-style groups — one admin, up to 3 co-admins.
model CommunityGroup {
  id        String   @id @default(cuid())
  name      String
  desc      String?
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  members  GroupMember[]
  messages GroupMessage[]
}

model GroupMember {
  groupId  String
  group    CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole      @default(MEMBER)
  joinedAt DateTime       @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id        String         @id @default(cuid())
  groupId   String
  group     CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime       @default(now())

  @@index([groupId, createdAt])
}

enum ApplicationIntent {
  PERFORM
  ATTEND
}

// ------------------------------------------------- Availability + analytics
// A day is "free" unless the owner marked it busy here, or a CONFIRMED booking
// exists for it (shown as "booked"). Only busy days are stored.
model Availability {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // "YYYY-MM-DD"
  status String @default("BUSY")

  @@unique([userId, date])
  @@index([userId])
}

// One row per profile per day (IST) — a privacy-friendly view counter, no viewer identities.
model ProfileViewDay {
  profileId String
  day       String // "YYYY-MM-DD"
  views     Int    @default(0)

  @@id([profileId, day])
}


// ------------------------------------------------------- Trust & safety
// A report about a person, post or message. Reviewed by the Gigset team.
model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // USER | POST | MESSAGE | OPPORTUNITY
  targetId   String
  reason     String
  details    String?
  status     String   @default("OPEN") // OPEN | REVIEWED | ACTIONED | DISMISSED
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([targetType, targetId])
}

// One person blocking another: no messages, booking requests or follows either way.
model Block {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// A review for a confirmed booking, written by either side about the other.
model Review {
  id         String   @id @default(cuid())
  bookingId  String
  reviewerId String
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId String
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  rating     Int // 1..5
  body       String?
  createdAt  DateTime @default(now())

  @@unique([bookingId, reviewerId])
  @@index([revieweeId, createdAt])
}

// ---------------------------------------------------------- Web push
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
